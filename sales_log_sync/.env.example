# sales.sif.tokyo のログイン情報（配布されたID/パス）
SIF_LOGIN_ID=
SIF_LOGIN_PASSWORD=

# ログCSVダウンロードページのURL
SIF_SITE_URL=http://sales.sif.tokyo/?site_code=sao_android_jp_release

# ログイン画面の入力欄セレクタ（サイトのHTML構造に合わせて必要なら調整）
SIF_LOGIN_ID_SELECTOR=input[name="login_id"], input[name="id"], input[type="text"]
SIF_LOGIN_PASSWORD_SELECTOR=input[name="password"], input[type="password"]
SIF_LOGIN_SUBMIT_SELECTOR=button[type="submit"], input[type="submit"]

# 期間指定（未指定なら「当月1日〜今日」を自動設定）
SIF_DATE_FROM=
SIF_DATE_TO=

# ダウンロード先ローカルフォルダ
DOWNLOAD_DIR=./downloads

# Google Drive アップロード先（この配下にログ種別ごとのサブフォルダを作成/使用）
GDRIVE_PARENT_FOLDER_ID=
GDRIVE_SERVICE_ACCOUNT_FILE=./service_account.json

# ブラウザをヘッドレスで動かすか（デバッグ時は false にして目視確認）
HEADLESS=true
